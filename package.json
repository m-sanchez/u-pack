{
  "name": "u-pack",
  "version": "1.1.0",
  "description": "Defeat lost-in-the-middle by construction: rank context items, fold the strongest to the prompt's edges, budget without silent drops.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "bench": "node bench/needle.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-sanchez/u-pack.git"
  },
  "author": "Miguel Sanchez <contact@miguelsanchez.co.uk>",
  "license": "MIT",
  "keywords": [
    "llm",
    "context",
    "prompt",
    "rag",
    "lost-in-the-middle",
    "typescript"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.7.0"
  },
  "types": "./dist/index.d.ts"
}
